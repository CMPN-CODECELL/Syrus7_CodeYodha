# Copy to .env (never commit .env). Everything here is optional; the stack runs fully local and free without it.

# Optional free-tier LLMs. Countersign is model-agnostic: safety never depends on which model runs.
# Gemini free tier: https://aistudio.google.com/apikey   (free-tier prompts may be used by Google; use demo data only)
CS_GEMINI_API_KEY=
CS_GEMINI_MODEL=gemini-3.5-flash
# GroqCloud free tier: https://console.groq.com/keys
CS_GROQ_API_KEY=
CS_GROQ_MODEL=openai/gpt-oss-20b
# Local Ollama (default, offline, free)
CS_OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# auto = first available in CS_LLM_ORDER (fastest measured: Groq), then deterministic
CS_LLM_PROVIDER=auto
CS_LLM_ORDER=groq,gemini,ollama

# Extra browser origins allowed besides http://localhost:3000, comma separated. Passkeys use the hostname of the
# origin the page is on, so an HTTPS tunnel such as https://countersign.example.com works for Touch ID and Face ID.
CS_EXTRA_ORIGINS=http://127.0.0.1:3000

# Demo behaviour
CS_DEMO_MODE=true
CS_MARKET_ALWAYS_OPEN=true
CS_APPROVAL_TTL_SECONDS=60
CS_PRICE_BAND_BPS=100

# Broker keys are generated automatically into .secrets/broker_keys.json by scripts/dev.py and handed to each
# process separately. Do not put them here.
